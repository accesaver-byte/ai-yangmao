{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-yangmao",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "DAILY_TOKEN_CAP": "0", "MONTHLY_COST_CAP_CNY": "72" },
  // 网站页面（静态资源）；/api/* 先交给 Worker
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/rss.xml"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "ai-yangmao", "database_id": "41f11fe0-342f-405d-b598-a0572edabceb", "migrations_dir": "migrations" }
  ],
  "routes": [{ "pattern": "ai-yangmao.com", "custom_domain": true }],
  // 定时任务（UTC）：0 0 * * * = 东京 09:00 飞书日报；7 * * * * = 每小时加急；17 */6 * * * = 每 6 小时触发采集
  "triggers": { "crons": ["0 0 * * *", "7 * * * *", "17 */6 * * *", "27 * * * *"] },
  "observability": { "enabled": true }
}
