{
  "name": "ai-yangmao",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "dev": "npm run build:web && wrangler dev --local --ip 127.0.0.1",
    "deploy": "npm run build:web && wrangler deploy --keep-vars",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply ai-yangmao --local",
    "db:migrate": "wrangler d1 migrations apply ai-yangmao --remote",
    "seed:sql": "node scripts/gen-seed.ts > seed/seed.sql",
    "seed:local": "npm run seed:sql && wrangler d1 execute ai-yangmao --local --file seed/seed.sql",
    "seed:demo:local": "node scripts/seed-local-demo.mjs",
    "seed": "npm run seed:sql && wrangler d1 execute ai-yangmao --remote --file seed/seed.sql",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run tests src && node --test .claude/skills/yangmao-review/evals/cli.test.mjs",
    "collect": "tsx pipeline/run.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "drizzle-orm": "^0.45.3",
    "echarts": "^6.1.0",
    "hono": "^4.13.11",
    "jsonrepair": "^3.15.0",
    "undici": "^7.29.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "@mozilla/readability": "^0.6.0",
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "fast-xml-parser": "^5.11.2",
    "linkedom": "^0.18.13",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
